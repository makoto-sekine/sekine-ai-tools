{
  "manifest_version": 3,
  "name": "MeetingRecorder - Google Meet検知",
  "version": "1.0.0",
  "description": "Google Meetの参加・退出を検知してMeetingRecorderアプリに通知します",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost:52828/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
